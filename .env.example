# ==============================================================================
# Resume Checker AI - Production & Development Environment Configuration
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Free M0 Cluster)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/resume_checker_ai?retryWrites=true&w=majority

# Authentication Security (Generate a secure 64-char hex key for production)
JWT_SECRET=replace_with_a_long_random_64_character_hex_secret_in_production
JWT_EXPIRE=30d

# Cross-Origin Resource Sharing (CORS)
# Set to your production Vercel frontend URL (comma-separated if multiple domains)
CLIENT_URL=https://resume-checker-ai.vercel.app
ALLOW_VERCEL_PREVIEWS=true

# Upload Limits (in Megabytes)
MAX_UPLOAD_SIZE_MB=10

# Optional Generative AI Features (Google Gemini / OpenAI)
# If omitted, application uses the high-accuracy built-in heuristic rule engine
GEMINI_API_KEY=
# OPENAI_API_KEY=
